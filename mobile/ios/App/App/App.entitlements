<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode switches this to "production" when it builds for TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Links to www.lumiosports.com open in the app (served by src/app/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.lumiosports.com</string>
	</array>
</dict>
</plist>
