API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
CRON_SECRET=
N8N_BASE_URL=

# Coach portal OAuth (Google / Microsoft) — a switch per provider, because they
# go live at different times:
#
#   COACH_OAUTH_LIVE=google             Gmail + Google Calendar on, Outlook parked
#   COACH_OAUTH_LIVE=google,microsoft   both on
#   COACH_OAUTH_LIVE=true               both on (the old spelling)
#   unset / false                       neither — the portal shows "Coming soon"
#
# Turn a provider on only once its console is ready, because nothing in the app
# can detect that. For Google that means the OAuth consent screen is PUBLISHED
# (in "Testing" the refresh token dies after 7 days and every coach has to
# reconnect weekly), the redirect URI below is registered, and the coach is
# warned about the unverified-app screen. iCloud is unaffected — it isn't OAuth.
#
# Redirect URI to register with each provider:
#   <PUBLIC_SITE_URL>/api/coach/oauth/google/callback
#   <PUBLIC_SITE_URL>/api/coach/oauth/microsoft/callback
COACH_OAUTH_LIVE=false

# ── Public origin for links that leave the server ────────────────────────────
# Stripe success/cancel URLs, OAuth redirects, camp sign-up links in emails.
# Behind nginx, Next resolves the request URL against the internal bind address,
# so without one of these set the app builds links to http://0.0.0.0:3000 — fine
# for a redirect nobody sees, fatal for the page a parent lands on after paying.
# PUBLIC_SITE_URL wins; OAUTH_REDIRECT_BASE is read as a fallback for the
# deployments that already set it. No trailing slash.
PUBLIC_SITE_URL=https://lumiosports.com
# OAUTH_REDIRECT_BASE=https://lumiosports.com

# How many proxies write to X-Forwarded-For in front of this app. One nginx = 1.
# Rate limiting counts back this many entries from the end of the header to find
# the last address it can trust, so put a CDN in front and this becomes 2 —
# leave it wrong and per-IP limits either group everyone together or key off an
# address the caller chose. Defaults to 1 if unset.
TRUSTED_PROXY_HOPS=1

# ── Discord (camp channels) ──────────────────────────────────────────────────
# One Lumio application with a bot; each coach invites that bot into their own
# server from Settings → the camp's Discord tab. No per-coach credentials.
#
# Create at https://discord.com/developers/applications:
#   1. New Application → Bot → Reset Token (this is DISCORD_BOT_TOKEN)
#   2. Bot → Privileged Gateway Intents → turn ON "Message Content Intent".
#      Self-service below 10,000 servers; above that Discord reviews it.
#   3. The application's Client ID is DISCORD_CLIENT_ID — it builds the invite
#      link and identifies the bot's own messages so mirrored posts are never
#      read back in.
# Unset = the camp Discord tab says it is not configured and nothing polls.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# The camp channel poll. Every minute, because it is a conversation:
#   * * * * * curl -sS -X POST http://127.0.0.1:3000/api/cron/discord-sync \
#     -H "Authorization: Bearer $CRON_SECRET" > /dev/null
